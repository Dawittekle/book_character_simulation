APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=5000

LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.7
MAX_SOURCE_CHARACTERS=50000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

CHROMA_DB_PATH=chroma_db
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=10
SQLALCHEMY_ECHO=false
AUTO_CREATE_RELATIONAL_SCHEMA=false

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173
ANONYMIZED_TELEMETRY=false

ADMIN_EMAIL=admin@lorely.app
ADMIN_PASSWORD=LorelyAdmin2026!Secure

# Cloudflare R2 Object Storage (Zero egress fees, S3 compatible)
# In Cloudflare Dashboard -> R2 Object Storage:
# 1. Create a bucket (e.g., "lorely-books")
# 2. Go to "Manage R2 API Tokens" -> "Create API token" with Admin Read & Write permissions
# 3. Copy Account ID, Access Key ID, and Secret Access Key below:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lorely-books
# Optional: R2 public URL or custom domain (e.g. https://pub-xxxx.r2.dev or https://assets.lorely.app)
R2_PUBLIC_URL=
# Fallback local directory for uploads when R2 credentials are not set (defaults to storage/)
STORAGE_LOCAL_DIR=storage
