{
  "brand": {
    "name": "Lorely",
    "tagline": "Cognitive Literary Character Simulation & Voice Dialogue Platform",
    "signature": "Shaping Minds of Classic Literature"
  },
  "colors": {
    "primary": {
      "orange": "#ef4d23",
      "orangeHover": "#d9421a",
      "orangeActive": "#bf3814",
      "orangeSoft": "rgba(239, 77, 35, 0.08)",
      "orangeBorder": "rgba(239, 77, 35, 0.25)"
    },
    "neutral": {
      "obsidian": "#0b0f1a",
      "obsidianHover": "#171c2d",
      "textStrong": "#0b0f1a",
      "textBase": "#374151",
      "textMuted": "#6b7280",
      "textSubtle": "#9ca3af",
      "pageBg": "#ededed",
      "heroCanvas": "#d9d9d9",
      "dashboardTray": "#f5f2ee",
      "surfaceWhite": "#ffffff",
      "surfaceCard": "#ffffff",
      "borderLight": "#e5e5e5",
      "borderSubtle": "#d4d4d8",
      "borderHero": "rgba(0, 0, 0, 0.06)"
    },
    "accents": {
      "skyBlueBg": "#eff6ff",
      "skyBlueCard": "#e0f2fe",
      "skyBlueText": "#0284c7",
      "skyBlueChart": "#38bdf8",
      "redNegative": "#ef4444",
      "redNegativeBg": "#fef2f2",
      "greenPositive": "#10b981",
      "greenPositiveBg": "#ecfdf5",
      "amberWarning": "#f59e0b",
      "amberWarningBg": "#fffbeb"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": "'Instrument Serif', Georgia, serif",
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "heroHeadline": {
      "fontSize": "clamp(36px, 8vw, 72px)",
      "lineHeight": "1.05",
      "fontWeight": "500",
      "letterSpacing": "-0.02em"
    },
    "heroSubtitle": {
      "fontSize": "clamp(13px, 3.5vw, 16px)",
      "lineHeight": "1.5",
      "fontWeight": "400"
    }
  },
  "radii": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px",
    "full": "9999px"
  },
  "shadows": {
    "pill": "0 2px 8px rgba(0, 0, 0, 0.04)",
    "card": "0 4px 20px -2px rgba(0, 0, 0, 0.05)",
    "cardElevated": "0 12px 32px -4px rgba(0, 0, 0, 0.08)",
    "modal": "0 24px 64px -12px rgba(11, 15, 26, 0.16)",
    "orangeGlow": "0 0 20px rgba(239, 77, 35, 0.35)"
  },
  "components": {
    "floatingNavPill": {
      "maxWidth": "760px",
      "borderRadius": "9999px",
      "backgroundColor": "#ffffff",
      "borderColor": "#e5e5e5",
      "shadow": "0 2px 8px rgba(0, 0, 0, 0.04)"
    },
    "heroContainer": {
      "borderRadius": "24px (sm: 32px)",
      "outerPadding": "12px (sm: 16px)",
      "backgroundColor": "#d9d9d9",
      "overlay": "rgba(255, 255, 255, 0.10)"
    },
    "dashboardTray": {
      "maxWidth": "880px",
      "backgroundColor": "#f5f2ee",
      "borderRadius": "24px"
    },
    "buttons": {
      "primaryOrange": {
        "bg": "#ef4d23",
        "text": "#ffffff",
        "borderRadius": "9999px",
        "innerIconBg": "rgba(255, 255, 255, 0.20)"
      },
      "darkObsidian": {
        "bg": "#0b0f1a",
        "text": "#ffffff",
        "borderRadius": "9999px",
        "innerIconBg": "rgba(255, 255, 255, 0.15)"
      },
      "secondaryWhite": {
        "bg": "#ffffff",
        "text": "#0b0f1a",
        "border": "#e5e5e5",
        "borderRadius": "9999px"
      }
    }
  },
  "rules": {
    "strictlyProhibited": [
      "No shopping cart icon or e-commerce features anywhere in the app",
      "No generic AI robotic aesthetic (use editorial typography and ethereal light canvases)",
      "No mismatched random colors (stick strictly to #ef4d23, #0b0f1a, #ededed, #f5f2ee, #ffffff)",
      "No hard harsh corners (always use rounded-2xl or rounded-full pills for badges/actions)"
    ]
  }
}
